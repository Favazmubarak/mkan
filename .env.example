# ==============================================================================
# MKAN CONCEPT — PRODUCTION & LOCAL ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# In local development without MongoDB, the website automatically falls back to static seed data.
# When connected, it provides live editing, instant publishing, and message inbox storage.
# Recommended Region for UAE: Middle East (Bahrain / AWS me-south-1 or Azure UAE North)
MONGODB_URI=mongodb+srv://thomas10shelby10_db_user:YbLaFxlfHZrYILxy@cluster0.wayyqup.mongodb.net/?appName=Cluster0

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Initial Superadmin credentials created during `npm run seed`
ADMIN_DEFAULT_EMAIL=admin@mkanconcept.ae
ADMIN_DEFAULT_PASSWORD=Mkan@Luxury2026

# Cryptographic random 32+ character hex string for signing admin session cookies
ADMIN_SESSION_SECRET=mkan2026secretkey32charslong!!x

# ------------------------------------------------------------------------------
# 3. EMAIL DISPATCH SETTINGS (Contact Form Inquiries)
# ------------------------------------------------------------------------------
# Where visitor inquiries should be sent:
CONTACT_EMAIL_TO=info@mkanconcept.ae

# OPTION A: Gmail / Standard SMTP (Recommended if client does not have a verified domain)
SMTP_USER=mkanconcept@gmail.com
SMTP_PASS=your-16-char-gmail-app-password

# OPTION B: Resend (Alternative API email service)
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL_FROM=onboarding@resend.dev

# ------------------------------------------------------------------------------
# 4. MEDIA & CLOUDFLARE R2 OBJECT STORAGE (Optional)
# ------------------------------------------------------------------------------
# If omitted, uploaded images are processed with Sharp and saved to /public/uploads/
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mkan-assets
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_DOMAIN=https://media.mkanconcept.ae
