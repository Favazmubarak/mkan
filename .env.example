# Copy this file to .env.local for local development and replace placeholders.
# Never put real credentials in this tracked example file.

# MongoDB Atlas. Use a database user created for this application.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database-name>

# Initial admin created by `npm run seed`; use unique local values.
ADMIN_DEFAULT_EMAIL=admin@example.com
ADMIN_DEFAULT_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Contact form notifications via Resend.
CONTACT_EMAIL_TO=team@example.com
RESEND_API_KEY=re_your_resend_api_key
# Use an address on a domain verified in Resend for production.
CONTACT_EMAIL_FROM=website@example.com

# Optional Cloudflare R2 image storage. Leave unset to use local storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=
